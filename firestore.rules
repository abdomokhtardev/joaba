rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // 🛡️ دوال الأمان المركزية (Security Helpers)
    // =========================================================================
    
    // التحقق من أن المستخدم مسجل دخول ومصادق عليه
    function isAuth() {
      return request.auth != null;
    }

    // معرف المستخدم الحالي
    function uid() {
      return request.auth.uid;
    }

    // التحقق من أن المستخدم هو صاحب هذا المعرف
    function isOwner(userId) {
      return isAuth() && uid() == userId;
    }

    // جلب بيانات المستخدم من مجموعة users بأمان
    function getUserData() {
      let userDoc = get(/databases/$(database)/documents/users/$(uid()));
      return userDoc != null ? userDoc.data : {};
    }

    // التحقق مما إذا كان المستخدم أدمن المنصة
    function isAdmin() {
      return isAuth() && (
        request.auth.token.get('role', '') == 'admin' ||
        getUserData().get('role', 'user') == 'admin'
      );
    }

    // التحقق من أن حساب المستخدم نشط وغير موقوف (Active)
    function isUserActive() {
      return isAuth() && getUserData().get('status', 'active') == 'active';
    }

    // =========================================================================
    // 1. إدارة المستخدمين (Users Collection)
    // =========================================================================
    match /users/{userId} {
      // القراءة: صاحب الحساب أو الأدمن (المستخدم الموقوف مسموح له بقراءة حسابه لمعرفة حالته)
      allow read: if isOwner(userId) || isAdmin();
      
      // الإنشاء: عند تسجيل حساب جديد، يمنع المستخدم من منح نفسه رتبة أدمن أو حالة موقوف
      allow create: if isOwner(userId)
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('status', 'active') == 'active';
      
      // التعديل:
      // - الأدمن يملك كامل الصلاحيات (تغيير الرتبة، إيقاف الحساب، تمديد الاشتراك).
      // - المستخدم العادي يعدل بياناته الشخصية واشتراكه دون القدرة على تغيير رتبته أو حالته.
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.get('role', 'user') == resource.data.get('role', 'user')
        && request.resource.data.get('status', 'active') == resource.data.get('status', 'active')
      );
      
      // الحذف: للأدمن فقط
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. المشاريع ومساحات العمل (Projects & Subcollections)
    // =========================================================================
    match /projects/{projectId} {
      // get: صاحب المشروع فقط (حماية الخصوصية التامة)
      allow get: if isAuth() && resource.data.userId == uid();
      // list: صاحب المشروع، أو الأدمن (لجلب المعرفات أثناء الحذف التتابعي)
      allow list: if (isAuth() && resource.data.userId == uid()) || isAdmin();
      
      // الإنشاء والتعديل: لصاحب الحساب النشط فقط
      allow create: if isAuth() && request.resource.data.userId == uid() && isUserActive();
      allow update: if isAuth() && resource.data.userId == uid() && request.resource.data.userId == uid() && isUserActive();
      
      // الحذف: لصاحب المشروع، أو للأدمن عند الحذف التتابعي للحساب
      allow delete: if (isAuth() && resource.data.userId == uid()) || isAdmin();

      // المجموعات الفرعية داخل المشاريع (المهام والملاحظات الفرعية)
      match /{subcollection}/{docId} {
        allow get: if isAuth() && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == uid();
        allow list: if (isAuth() && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == uid()) || isAdmin();
        allow create, update: if isAuth() && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == uid() && isUserActive();
        allow delete: if (isAuth() && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == uid()) || isAdmin();
      }
    }

    // =========================================================================
    // 3. قبو الروابط (Links Vault)
    // =========================================================================
    match /links/{linkId} {
      allow get: if isAuth() && resource.data.userId == uid();
      allow list: if (isAuth() && resource.data.userId == uid()) || isAdmin();
      
      allow create: if isAuth() && request.resource.data.userId == uid() && isUserActive();
      allow update: if isAuth() && resource.data.userId == uid() && request.resource.data.userId == uid() && isUserActive();
      allow delete: if (isAuth() && resource.data.userId == uid()) || isAdmin();
    }

    // =========================================================================
    // 4. سجل اليوميات والأفكار (Journals)
    // =========================================================================
    match /journals/{journalId} {
      // خصوصية مطلقة: المالك فقط يقرأ نص يومياته، بينما الأدمن مسموح له فقط بـ list للحذف التتابعي
      allow get: if isAuth() && resource.data.userId == uid();
      allow list: if (isAuth() && resource.data.userId == uid()) || isAdmin();
      
      allow create: if isAuth() && request.resource.data.userId == uid() && isUserActive();
      allow update: if isAuth() && resource.data.userId == uid() && request.resource.data.userId == uid() && isUserActive();
      allow delete: if (isAuth() && resource.data.userId == uid()) || isAdmin();
    }

    // =========================================================================
    // 5. متتبع العادات (Habits Tracker)
    // =========================================================================
    match /habits/{habitId} {
      allow get: if isAuth() && resource.data.userId == uid();
      allow list: if (isAuth() && resource.data.userId == uid()) || isAdmin();
      
      allow create: if isAuth() && request.resource.data.userId == uid() && isUserActive();
      allow update: if isAuth() && resource.data.userId == uid() && request.resource.data.userId == uid() && isUserActive();
      allow delete: if (isAuth() && resource.data.userId == uid()) || isAdmin();
    }

    // =========================================================================
    // 6. طلبات الدفع والاشتراكات (Payment Requests)
    // =========================================================================
    match /payment_requests/{reqId} {
      allow read: if (isAuth() && resource.data.userId == uid()) || isAdmin();
      
      // الإنشاء: للمستخدم بحالة مبدئية معلقة pending
      allow create: if isAuth() && request.resource.data.userId == uid()
        && request.resource.data.get('status', 'pending') == 'pending';
      
      // التعديل:
      // - الأدمن يوافق أو يرفض أو يؤرشف
      // - المستخدم يمكنه فقط أرشفة أو إلغاء طلبه
      allow update: if isAdmin() || (
        isAuth() && resource.data.userId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['archived', 'cancelled']
      );
      
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 7. تذاكر الدعم والاقتراحات (Support Tickets)
    // =========================================================================
    match /support_tickets/{ticketId} {
      // القراءة: صاحب التذكرة لمتابعة الرد، أو الأدمن
      allow read: if (isAuth() && resource.data.userId == uid()) || isAdmin();
      
      // الإنشاء: لأي مستخدم مسجل دخول (حتى الموقوف لطلب المساعدة)
      allow create: if isAuth() && request.resource.data.userId == uid();
      
      // التعديل:
      // - الأدمن يضيف الرد ويغير الحالة
      // - المستخدم يحدث فقط إشعار القراءة userSeen
      allow update: if isAdmin() || (
        isAuth() && resource.data.userId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userSeen'])
      );
      
      // الحذف: للأدمن فقط لحفظ السجل التاريخي للدعم الفني
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 8. أكواد التفعيل (Activation Codes)
    // =========================================================================
    match /activation_codes/{codeId} {
      allow get: if isAuth();
      // حصر استعلام المستخدم بحد أقصى كود واحد لمنع تسريب أو كشط الأكواد
      allow list: if isAdmin() || (isAuth() && request.query.limit <= 1);
      
      allow create, delete: if isAdmin();
      
      // التعديل: الأدمن، أو المستخدم عند استخدام كود صالح لإلغاء تفعيله
      allow update: if isAdmin() || (
        isAuth()
        && resource.data.isValid == true
        && request.resource.data.isValid == false
      );
    }

    // =========================================================================
    // 9. أكواد الخصم الترويجية (Promo Codes)
    // =========================================================================
    match /promo_codes/{codeId} {
      allow get: if isAuth();
      // حصر استعلام المستخدم بكود واحد فقط
      allow list: if isAdmin() || (isAuth() && request.query.limit <= 1);
      allow write: if isAdmin();
    }

    // =========================================================================
    // 10. نظام المسوقين والعمولات (Affiliates)
    // =========================================================================
    match /affiliates/{affId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 11. الإعلانات والتحديثات (Announcements)
    // =========================================================================
    match /announcements/{annId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 12. الإعدادات العامة للمنصة (General Settings)
    // =========================================================================
    match /settings/{settingId} {
      // قراءة عامة للجميع (الشريط الإعلاني، مدة التجربة المجانية، معلومات التطبيق)
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 🔒 منع الوصول الافتراضي لأي مجموعة غير مصرح بها
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
